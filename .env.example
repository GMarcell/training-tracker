[TEMPLATE]
# PostgreSQL connection string.
# The default below matches docker-compose.yml (`docker compose up -d`):
# user "training", password "training", database "training_tracker" on port 5434.
# Any PostgreSQL instance works; point this at it and run `npx prisma migrate dev`.
DATABASE_URL="postgresql://training:training@127.0.0.1:5434/training_tracker?schema=public"

# Secret used to sign the 7-day session JWT. Use a long random value:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Groq API key for the AI program builder (optional; the rest of the app runs
# without it). Create one at https://console.groq.com/keys
GROQ_API_KEY=""

# Optional: override the Groq chat model used for program generation.
# GROQ_MODEL="openai/gpt-oss-120b"
